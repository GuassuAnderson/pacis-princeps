# URL e chave exclusivamente de servidor (Settings > API, no Supabase).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa para projetos que ainda usam a chave service_role:
SUPABASE_SERVICE_ROLE_KEY=
# Segredo de sessão: use pelo menos 32 caracteres aleatórios.
JWT_SECRET=
# Origem pública exata em produção, por exemplo https://loja.example.com
SITE_URL=
# Opcionais; compatibilidade com a configuração anterior.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente para scripts de migração, nunca enviar ao navegador.
DATABASE_URL=
